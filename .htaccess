# Set PHP Version to 8.2 for this Laravel project
# For LiteSpeed Web Server
#PHP82

# For Apache/mod_php (if using AddHandler)
<IfModule mod_php.c>
    # Uncomment and adjust based on your server's PHP handler path
    # AddHandler application/x-httpd-php82 .php
</IfModule>

# For FastCGI/PHP-FPM (most common on shared hosting)
<IfModule mod_fcgid.c>
    # This will be handled by cPanel's PHP Selector, but you can force it here
    # AddHandler fcgid-script .php
    # FCGIWrapper /usr/local/cpanel/scripts/php82 .php
</IfModule>

# Alternative: Use cPanel's PHP Selector via .htaccess
# Create a .htaccess in public_html with: AddHandler application/x-httpd-php82 .php
# Or use cPanel's "Select PHP Version" tool and choose 8.2, then "Set as current"

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Exclude api folder from Laravel routing (let it use its own PHP version)
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^ - [L]

    # Redirect everything to public/ except if already in public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_value upload_max_filesize 50M
   php_value post_max_size 60M
   php_value max_input_time 300
   php_value max_execution_time 300
   php_value memory_limit 256M
   php_value max_input_vars 5000
   php_value error_reporting E_ALL & ~E_DEPRECATED & ~E_STRICT
   php_flag display_errors Off
   php_flag display_startup_errors Off
   php_flag log_errors On
   php_value error_log "storage/logs/php-error.log"
   php_flag ignore_repeated_errors Off
   php_flag ignore_repeated_source Off
   php_flag report_memleaks On
   php_flag report_zend_debug Off
   php_value variables_order "GPCS"
   php_value request_order "GP"
   php_flag register_argc_argv Off
   php_flag auto_globals_jit On
   php_value default_mimetype "text/html"
   php_value default_charset "UTF-8"
   php_value session.cache_limiter "nocache"
   php_value session.cache_expire 180
   php_flag session.use_strict_mode On
   php_flag session.use_cookies On
   php_flag session.use_only_cookies On
   php_value session.name "PHPSESSID"
   php_value session.cookie_httponly "1"
   php_value session.cookie_secure "1"
   php_value session.cookie_samesite "Lax"
   php_value session.gc_maxlifetime 7200
   php_value session.gc_probability 0
   php_value session.sid_length 48
   php_value session.sid_bits_per_character 6
   php_value date.timezone "Asia/Dhaka"
   php_value default_socket_timeout 60
   php_value output_buffering 4096
   php_flag implicit_flush Off
   php_flag zlib.output_compression Off
   php_value mysqli.default_port 3306
</IfModule>
<IfModule lsapi_module>
   php_value upload_max_filesize 50M
   php_value post_max_size 60M
   php_value max_input_time 300
   php_value max_execution_time 300
   php_value memory_limit 256M
